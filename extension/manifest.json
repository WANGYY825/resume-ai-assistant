{
  "manifest_version": 3,
  "name": "AI 简历自动填写助手",
  "version": "0.2.0",
  "description": "扫描招聘页面表单字段，自动匹配并填写简历信息",

  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 简历填写助手"
  },

  "options_page": "options.html"
}
